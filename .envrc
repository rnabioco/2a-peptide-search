# Host-based output directory configuration
case "$(hostname -s)" in
  c3cpu-*|login*)
    # Alpine cluster - use /scratch filesystem
    export SCRATCH_DIR="/scratch/alpine/${USER}/2a-peptide-search"
    export RESULTS_DIR="${SCRATCH_DIR}/results"
    export DATA_DIR="${SCRATCH_DIR}/data"
    export LOGS_DIR="${SCRATCH_DIR}/logs"
    ;;
  amc-bodhi|compute*)
    # Bodhi cluster - use project directory directly
    export PROJECT_DIR="/beevol/home/jhessel/devel/rnabioco/2a-peptide-search"
    export RESULTS_DIR="${PROJECT_DIR}/results"
    export DATA_DIR="${PROJECT_DIR}/data/ref"
    export LOGS_DIR="${PROJECT_DIR}/logs"
    ;;
  *)
    # Default/local - use project directory
    export RESULTS_DIR="results"
    export DATA_DIR="data"
    export LOGS_DIR="logs"
    ;;
esac

# Auto-generate .Renviron for R/Quarto
cat >.Renviron <<EOF
RESULTS_DIR=$RESULTS_DIR
DATA_DIR=$DATA_DIR
EOF
